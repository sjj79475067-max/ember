# ===== 必填 =====
# 访问地址（公网部署时改成你的域名，如 https://ember.example.com）
APP_URL=http://localhost:3000
# 会话与加密密钥（生成：openssl rand -base64 32）
SESSION_SECRET=change-me-to-a-random-32-byte-string
# 数据库（Docker 内固定为 /app/data/ember.db；本机运行可改 ./data/ember.db）
DATABASE_URL=file:/app/data/ember.db
# 端口
EMBER_PORT=3000
